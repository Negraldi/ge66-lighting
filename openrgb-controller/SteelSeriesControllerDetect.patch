+void DetectSteelSeriesMSIGE66LightBar(hid_device_info* info, const std::string& name)
+{
+    hid_device* dev = hid_open_path(info->path);
+
+    if(dev)
+    {
+        SteelSeriesMSIGE66LightBarController*     controller     = new SteelSeriesMSIGE66LightBarController(dev, info->path, name);
+        RGBController_SteelSeriesMSIGE66LightBar* rgb_controller = new RGBController_SteelSeriesMSIGE66LightBar(controller);
+
+        ResourceManager::get()->RegisterRGBController(rgb_controller);
+    }
+}
+
+/*---------------------------------------------------------*\
+| The GE66 keyboard uses element tables for its firmware    |
+| modes and a host stream setup for Direct mode. Tested on  |
+| a GE66 Raider 10SGS with keyboard firmware 2.36.          |
+\*---------------------------------------------------------*/
+void DetectSteelSeriesMSIGE66Keyboard(hid_device_info* info, const std::string& name)
+{
+    hid_device* dev = hid_open_path(info->path);
+
+    if(dev)
+    {
+        SteelSeriesMSIGE66KeyboardController*     controller     = new SteelSeriesMSIGE66KeyboardController(dev, info->path, name);
+        RGBController_SteelSeriesMSIGE66Keyboard* rgb_controller = new RGBController_SteelSeriesMSIGE66Keyboard(controller);
+
+        ResourceManager::get()->RegisterRGBController(rgb_controller);
+    }
+}
